    private async Task ResetAiCooldowns()
    {
        IsResettingAiCooldowns = true;
        AiCooldownsReset = false;
        AiSettingsError = null;

        try
        {
            AiApiHealth.ResetPause();
            var resetAt = await DataService.ResetAiIrrigationCooldownsAsync();

            if (resetAt.HasValue)
            {
                await LoadAiSettings();
                await LoadLogs();
                AiCooldownsReset = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(2500);
                AiCooldownsReset = false;
            }
            else
            {
                AiSettingsError = "Cooldowns could not be reset. Check the system logs for details.";
            }
        }
        finally
        {
            IsResettingAiCooldowns = false;
        }
    }

    private async Task TestAiSituation()
    {
        if (AiConfig == null)
        {
            return;
        }

        IsTestingAiSituation = true;
        AiSituationError = null;
        AiSituationResult = null;

        try
        {
            if (Zones.Count == 0)
            {
                await LoadZones();
            }

            var zone = Zones.FirstOrDefault(zone => zone.Id == AiTestZoneId);
            if (zone == null)
            {
                AiSituationError = "Choose an active zone before testing an AI situation.";
                return;
            }

            var reading = new SensorReading
            {
                ZoneId = zone.Id,
                Moisture = Math.Clamp(AiTestMoisture, 0, 100),
                Temperature = AiTestTemperature,
                Humidity = Math.Clamp(AiTestHumidity, 0, 100),
                Pressure = AiTestPressure,
                RecordedAt = DateTime.UtcNow,
                Device = "settings-ai-test"
            };

            AiSituationResult = await DecisionService.PreviewAsync(reading, "settings-ai-situation-test");
            LatestAiApiCheck = AiApiHealth.GetLastResult();
            await LoadLogs();
        }
        catch (Exception ex)
        {
            AiSituationError = $"AI situation test failed: {ex.Message}";
        }
        finally
        {
            IsTestingAiSituation = false;
        }
    }

    private static bool LooksLikeSecretApiKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        return trimmed.StartsWith("sk-", StringComparison.OrdinalIgnoreCase) ||
               trimmed.StartsWith("sk_", StringComparison.OrdinalIgnoreCase);
    }

