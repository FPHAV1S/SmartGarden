            DeletedRecords = await DataService.CleanOldDataAsync(TimeSpan.FromSeconds(CleanupRetentionSeconds));
            CleanupComplete = true;
            await Task.Delay(3000);
            CleanupComplete = false;
        }
        finally
        {
            IsCleaning = false;
        }
    }
