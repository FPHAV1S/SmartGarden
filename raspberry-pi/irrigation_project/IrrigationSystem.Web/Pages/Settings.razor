@using IrrigationSystem.Web.Models
@using IrrigationSystem.Web.Services
@using System.Globalization
@using Microsoft.Extensions.Options
@page "/settings"
@layout MainLayout
@inject SensorDataService DataService
@inject AdaptiveWateringService AdaptiveService
@inject DemoModeService DemoService
@inject AiApiHealthService AiApiHealth
@inject OpenAiApiKeyProvider ApiKeyProvider
@inject IOptions<AiIrrigationOptions> AiDefaults
@inject WeatherForecastService Weather
@inject IrrigationDecisionService DecisionService
@implements IDisposable

<PageTitle>Settings - Irrigation System</PageTitle>

<div class="settings-page">
    <h3>System Settings</h3>

    @if (SystemConfig == null)
    {
        <p>Loading settings...</p>
    }
    else
    {
        <div class="settings-section">
            <h4>System Control</h4>
            
            <div class="settings-grid">
                <div class="setting-item">
                    <label class="toggle-label">
                        <input type="checkbox" @bind="SystemConfig.AutoWateringEnabled" @bind:after="SaveSettingsImmediate" class="toggle-input" />
                        <span class="toggle-slider-sm"></span>
                        <span class="toggle-text">Automatic Watering</span>
                    </label>
                    <small>Enable or disable automatic watering based on moisture levels</small>
                </div>

                <div class="setting-item">
                    <label>Default Watering Duration (seconds)</label>
                    <input type="number" min="5" max="60" @bind="SystemConfig.DefaultWateringDuration" @bind:after="SaveSettings" class="form-input" />
                    <small>How long to water each zone (5-60 seconds)</small>
                </div>
            </div>
        </div>

        <div class="settings-section">
            <h4>Night Mode Schedule</h4>
            <p>Restrict watering to nighttime hours to reduce evaporation</p>
            
            <div class="settings-grid">
                <div class="setting-item">
                    <label class="toggle-label">
                        <input type="checkbox" @bind="SystemConfig.NightModeEnabled" @bind:after="SaveSettingsImmediate" class="toggle-input" />
                        <span class="toggle-slider-sm"></span>
                        <span class="toggle-text">Enable Night Mode</span>
                    </label>
                    <small>Only water during specified hours</small>
                </div>

                @if (SystemConfig.NightModeEnabled)
                {
                    <div class="setting-item">
                        <label>Start Hour (24h format)</label>
                        <input type="number" min="0" max="23" @bind="SystemConfig.NightModeStartHour" @bind:after="SaveSettings" class="form-input" />
                        <small>Watering allowed from @SystemConfig.NightModeStartHour:00</small>
                    </div>

                    <div class="setting-item">
                        <label>End Hour (24h format)</label>
                        <input type="number" min="0" max="23" @bind="SystemConfig.NightModeEndHour" @bind:after="SaveSettings" class="form-input" />
                        <small>Watering allowed until @SystemConfig.NightModeEndHour:00</small>
                    </div>
                }
            </div>
        </div>

        <div class="settings-section">
            <h4>Eco Mode</h4>
            
            <div class="setting-item">
                <label class="toggle-label">
                    <input type="checkbox" @bind="SystemConfig.EcoModeEnabled" @bind:after="SaveSettingsImmediate" class="toggle-input" />
                    <span class="toggle-slider-sm"></span>
                    <span class="toggle-text">Enable Eco Mode</span>
                </label>
                <small>Reduce watering frequency to conserve water and battery</small>
            </div>
        </div>
    }

    <div class="settings-section">
        <h4>Adaptive Watering AI</h4>
        <p>The adaptive algorithm analyzes irrigation history and automatically adjusts moisture thresholds for optimal watering.</p>
        
        <button class="btn-primary" @onclick="RunAdaptiveAnalysis" disabled="@IsRunning">
            @if (IsRunning)
            {
                <span>⏳ Running Analysis...</span>
            }
            else
            {
                <span>▶️ Run Adaptive Analysis Now</span>
            }
        </button>

        @if (AnalysisComplete)
        {
            <div class="success-message">✓ Analysis complete! Check logs below for threshold changes.</div>
        }
    </div>

    <div class="settings-section">
        <h4>AI Decision Management</h4>

        @if (AiConfig == null)
        {
            <p>Loading AI settings...</p>
        }
        else
        {
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Decision AI:</span>
                    <span class="info-value">@(AiConfig.EnableAiDecisionMaking ? "Enabled" : "Disabled")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">AI provider:</span>
                    <span class="info-value">@AiConfig.Provider</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Provider access:</span>
                    <span class="info-value">@GetAiProviderAccessStatus()</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Model:</span>
                    <span class="info-value">@AiConfig.Model</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Last decision:</span>
                    <span class="info-value">@GetLatestAiDecisionSummary()</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Provider test:</span>
                    <span class="info-value">@(LatestAiApiCheck?.IsSuccess == true ? "Passed" : LatestAiApiCheck == null ? "Not tested" : "Failed")</span>
                </div>
            </div>

            @if (IsAiApiKeyMissing)
            {
                <div class="warning-message">@GetAiApiKeySource() is not set on this server.</div>
            }

            @if (!string.IsNullOrWhiteSpace(AiSettingsError))
            {
                <div class="warning-message">@AiSettingsError</div>
            }

            <div class="settings-grid mt-2">
                <div class="setting-item">
                    <label class="toggle-label">
                        <input type="checkbox" @bind="AiConfig.EnableAiDecisionMaking" class="toggle-input" />
                        <span class="toggle-slider-sm"></span>
                        <span class="toggle-text">Enable AI Decision Making</span>
                    </label>
                    <small>Sensor readings keep safety checks when this is off or the provider is unavailable</small>
                </div>

                <div class="setting-item">
                    <label>AI Provider</label>
                    <select @bind="AiConfig.Provider" class="form-input">
                        <option value="@AiIrrigationOptions.OllamaProvider">Ollama</option>
                        <option value="@AiIrrigationOptions.OpenAiProvider">OpenAI</option>
                    </select>
                    <small>Ollama uses the local laptop model; OpenAI uses the hosted API</small>
                </div>

                <div class="setting-item">
                    <label>AI Model</label>
                    <input type="text" @bind="AiConfig.Model" class="form-input" />
                    <small>Configured model name used for irrigation analysis</small>
                </div>

                @if (AiConfig.UsesOllama)
                {
                    <div class="setting-item">
                        <label>Ollama Base URL</label>
                        <input type="text"
                               maxlength="200"
                               placeholder="http://localhost:11434"
                               @bind="AiConfig.OllamaBaseUrl"
                               class="form-input" />
                        <small>Local Ollama API endpoint used by the web app</small>
                    </div>
                }
                else
                {
                    <div class="setting-item">
                        <label>API Key Environment Variable Name</label>
                        <input type="text"
                               maxlength="100"
                               placeholder="OPENAI_API_KEY"
                               @bind="AiConfig.ApiKeyEnvironmentVariable"
                               class="form-input" />
                        <small>Put the secret key in PowerShell as OPENAI_API_KEY; this box stores only the variable name</small>
                    </div>
                }

                <div class="setting-item">
                    <label>Minimum Minutes Between AI Calls</label>
                    <input type="number" min="0" max="1440" @bind="AiConfig.MinimumMinutesBetweenAiCalls" class="form-input" />
                    <small>Current cooldown: @AiConfig.MinimumMinutesBetweenAiCalls minute(s)</small>
                </div>

                <div class="setting-item">
                    <label>Recent History Window (hours)</label>
                    <input type="number" min="1" max="168" @bind="AiConfig.RecentHistoryHours" class="form-input" />
                    <small>Readings included in the AI prompt</small>
                </div>

                <div class="setting-item">
                    <label>Recent Watering Events</label>
                    <input type="number" min="1" max="100" @bind="AiConfig.RecentWateringEvents" class="form-input" />
                    <small>Watering events included in the AI prompt</small>
                </div>

                <div class="setting-item">
                    <label>Pattern Memory Count</label>
                    <input type="number" min="1" max="50" @bind="AiConfig.PatternMemoryCount" class="form-input" />
                    <small>Saved observations included in each AI prompt</small>
                </div>

                <div class="setting-item">
                    <label>High Moisture Block (%)</label>
                    <input type="number" min="0" max="100" step="0.5" @bind="AiConfig.HighMoistureBlockPercent" class="form-input" />
                    <small>Watering is blocked at or above @AiConfig.HighMoistureBlockPercent.ToString("F1")%</small>
                </div>

                <div class="setting-item">
                    <label>Low Confidence Threshold</label>
                    <input type="number" min="0" max="1" step="0.05" @bind="AiConfig.LowConfidenceThreshold" class="form-input" />
                    <small>Fallback rules are used below @AiConfig.LowConfidenceThreshold.ToString("F2") confidence</small>
                </div>

                <div class="setting-item">
                    <label>Max AI Watering Duration (seconds)</label>
                    <input type="number" min="1" max="3600" @bind="AiConfig.MaxDurationSeconds" class="form-input" />
                    <small>AI recommendations are clamped to this limit</small>
                </div>

                <div class="setting-item">
                    <label class="toggle-label">
                        <input type="checkbox" @bind="AiConfig.EnableWateringCooldown" class="toggle-input" />
                        <span class="toggle-slider-sm"></span>
                        <span class="toggle-text">Enable Watering Cooldown</span>
                    </label>
                    <small>Block repeated automatic watering for the same zone after a recent watering event</small>
                </div>

                <div class="setting-item">
                    <label>Minimum Minutes Between Waterings</label>
                    <input type="number" min="0" max="1440" @bind="AiConfig.MinimumMinutesBetweenWaterings" class="form-input" disabled="@(!AiConfig.EnableWateringCooldown)" />
                    <small>@(AiConfig.EnableWateringCooldown ? "Safety cooldown between watering events for a zone" : "Cooldown is disabled; automatic watering can run without this interval check")</small>
                </div>

                <div class="setting-item">
                    <label>Fallback Duration (seconds)</label>
                    <input type="number" min="1" max="3600" @bind="AiConfig.DefaultFallbackDurationSeconds" class="form-input" />
                    <small>Rule-based duration when AI is unavailable</small>
                </div>
            </div>

            <div class="settings-actions">
                <button class="btn-primary" @onclick="SaveAiSettings" disabled="@IsSavingAiSettings">
                    @(IsSavingAiSettings ? "Saving AI Settings..." : "Save AI Settings")
                </button>
                <button class="btn-warning" @onclick="TestAiApi" disabled="@IsTestingAiApi">
                    @(IsTestingAiApi ? "Testing AI Provider..." : "Test AI Provider")
                </button>
                <button class="btn-secondary" @onclick="ResetAiCooldowns" disabled="@IsResettingAiCooldowns">
                    @(IsResettingAiCooldowns ? "Resetting Cooldowns..." : "Reset Cooldowns")
                </button>
                <button class="btn-secondary" @onclick="LoadAiSettings">Refresh AI Status</button>
            </div>

            @if (AiSettingsSaved)
            {
                <div class="success-message">AI settings saved.</div>
            }

            @if (AiCooldownsReset)
            {
                <div class="success-message">AI and watering cooldowns reset.</div>
            }

            <div class="mt-2">
                <h4>AI Situation Test</h4>
                <div class="settings-grid">
                    <div class="setting-item">
                        <label>Zone</label>
                        <select @bind="AiTestZoneId" class="form-input">
                            @foreach (var zone in Zones)
                            {
                                <option value="@zone.Id">@zone.Name (@zone.Id)</option>
                            }
                        </select>
                    </div>
                    <div class="setting-item">
                        <label>Moisture (%)</label>
                        <input type="number" min="0" max="100" step="0.1" @bind="AiTestMoisture" class="form-input" />
                    </div>
                    <div class="setting-item">
                        <label>Temperature (C)</label>
                        <input type="number" step="0.1" @bind="AiTestTemperature" class="form-input" />
                    </div>
                    <div class="setting-item">
                        <label>Humidity (%)</label>
                        <input type="number" min="0" max="100" step="0.1" @bind="AiTestHumidity" class="form-input" />
                    </div>
                    <div class="setting-item">
                        <label>Pressure (hPa)</label>
                        <input type="number" step="0.1" @bind="AiTestPressure" class="form-input" />
                    </div>
                </div>

                <div class="settings-actions">
                    <button class="btn-warning" @onclick="TestAiSituation" disabled="@IsTestingAiSituation">
                        @(IsTestingAiSituation ? "Testing Situation..." : "Test AI Situation")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(AiSituationError))
                {
                    <div class="warning-message">@AiSituationError</div>
                }

                @if (AiSituationResult != null)
                {
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Final valve:</span>
                            <span class="info-value">@AiSituationResult.RecommendedValveState</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Duration:</span>
                            <span class="info-value">@AiSituationResult.RecommendedDurationSeconds s</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">AI attempted:</span>
                            <span class="info-value">@(AiSituationResult.AiWasAttempted ? "Yes" : "No")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Decision source:</span>
                            <span class="info-value">@(AiSituationResult.WasFallbackUsed ? "Safety rules" : "AI")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Confidence:</span>
                            <span class="info-value">@AiSituationResult.Confidence.ToString("F2")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Risk:</span>
                            <span class="info-value">@AiSituationResult.RiskLevel</span>
                        </div>
                    </div>
                    <div class="info-message">@AiSituationResult.Reason</div>
                    @if (!string.IsNullOrWhiteSpace(AiSituationResult.SafetyNotes))
                    {
                        <div class="warning-message">@AiSituationResult.SafetyNotes</div>
                    }
                }
            </div>

            @if (LatestAiApiCheck != null)
            {
                <div class="@(LatestAiApiCheck.IsSuccess ? "success-message" : "warning-message")">
                    @FormatLocalTime(LatestAiApiCheck.CheckedAt, "HH:mm:ss") - @LatestAiApiCheck.Message
                    @if (LatestAiApiCheck.RetryAfter.HasValue && LatestAiApiCheck.RetryAfter.Value > DateTime.UtcNow)
                    {
                        <span> Next automatic retry after @FormatLocalTime(LatestAiApiCheck.RetryAfter.Value, "HH:mm").</span>
                    }
                </div>
            }
        }
    </div>

    <div class="settings-section">
        <h4>Weather Integration</h4>
        @if (WeatherConfig == null)
        {
            <p>Loading weather settings...</p>
        }
        else
        {
            <div class="settings-grid mt-2">
                <div class="setting-item">
                    <label class="toggle-label">
                        <input type="checkbox" @bind="WeatherConfig.EnableWeatherIntegration" class="toggle-input" />
                        <span class="toggle-slider-sm"></span>
                        <span class="toggle-text">Enable Open-Meteo Integration</span>
                    </label>
                    <small>Fetch forecasts to prevent watering when rain is expected</small>
                </div>
                
                <div class="setting-item">
                    <label>Latitude</label>
                    <input type="number" step="0.0001" @bind="WeatherConfig.Latitude" class="form-input" />
                </div>
                
                <div class="setting-item">
                    <label>Longitude</label>
                    <input type="number" step="0.0001" @bind="WeatherConfig.Longitude" class="form-input" />
                </div>
                
                <div class="setting-item">
                    <label>Rain Probability Threshold (%)</label>
                    <input type="number" min="0" max="100" @bind="WeatherConfig.RainProbabilityThresholdPercent" class="form-input" />
                </div>
                
                <div class="setting-item">
                    <label>Rain Lookahead (hours)</label>
                    <input type="number" min="1" max="48" @bind="WeatherConfig.RainLookaheadHours" class="form-input" />
                </div>
                
                <div class="setting-item">
                    <label>Expected Rain Threshold (mm)</label>
                    <input type="number" step="0.1" @bind="WeatherConfig.ExpectedRainMmThreshold" class="form-input" />
                </div>
                
                <div class="setting-item">
                    <label>Confirmed Pause Duration (hours)</label>
                    <input type="number" min="1" max="72" @bind="WeatherConfig.ConfirmedWeatherPauseHours" class="form-input" />
                </div>
            </div>

            <div class="settings-actions">
                <button class="btn-primary" @onclick="SaveWeatherSettings" disabled="@IsSavingWeatherSettings">
                    @(IsSavingWeatherSettings ? "Saving..." : "Save Weather Settings")
                </button>
                <button class="btn-secondary" @onclick="TestWeatherApi">Test Weather API</button>
            </div>

            @if (WeatherSettingsSaved)
            {
                <div class="success-message">Weather settings saved.</div>
            }

            @if (!string.IsNullOrWhiteSpace(WeatherSettingsError))
            {
                <div class="warning-message">@WeatherSettingsError</div>
            }

            @if (LatestWeatherAdvice != null)
            {
                <div class="weather-info-panel">
                    <p><strong>Latest weather advice:</strong> @LatestWeatherAdvice.AdviceText</p>
                    <p>
                        Rain probability: @LatestWeatherAdvice.MaxRainProbabilityPercent% &nbsp;|&nbsp;
                        Expected rain: @LatestWeatherAdvice.ExpectedRainMm.ToString("F1", CultureInfo.InvariantCulture) mm &nbsp;|&nbsp;
                        Lookahead: @LatestWeatherAdvice.LookaheadHours hours
                    </p>
                    <p>
                        Forecast temperature now: @FormatTemperature(LatestWeatherAdvice.CurrentTemperatureC) &nbsp;|&nbsp;
                        Average: @FormatTemperature(LatestWeatherAdvice.AverageTemperatureC) &nbsp;|&nbsp;
                        Range: @FormatTemperatureRange(LatestWeatherAdvice.MinTemperatureC, LatestWeatherAdvice.MaxTemperatureC)
                    </p>
                    <p>Last updated: @FormatLocalTime(LatestWeatherAdvice.LastUpdated, "g")</p>
                </div>
            }
        }
    </div>

    <div class="settings-section">
        <h4>Database Management</h4>
        <p>Clean up old sensor readings to save storage space</p>
        
        <div class="cleanup-controls">
            <label>Keep data from last:</label>
            <select @bind="CleanupRetentionSeconds" class="form-input-inline">
                <option value="1">1 second</option>
                <option value="604800">7 days</option>
                <option value="1209600">14 days</option>
                <option value="2592000">30 days</option>
                <option value="5184000">60 days</option>
                <option value="7776000">90 days</option>
            </select>
            
            <button class="btn-warning" @onclick="CleanDatabase" disabled="@IsCleaning">
                @if (IsCleaning)
                {
                    <span>🗑️ Cleaning...</span>
                }
                else
                {
                    <span>🗑️ Clean Old Data</span>
                }
            </button>
        </div>

        @if (CleanupComplete)
        {
            <div class="success-message">✓ Deleted @DeletedRecords old sensor readings</div>
        }
    </div>

    <div class="settings-section">
        <h4>Recent System Logs</h4>
        
        @if (IsLoadingLogs)
        {
            <p>Loading logs...</p>
        }
        else if (SystemLogs.Count == 0)
        {
            <p>No logs yet.</p>
        }
        else
        {
            <div class="logs-container">
                @foreach (var log in SystemLogs)
                {
                    <div class="log-entry @log.Level.ToLower()">
                        <span class="log-time">@FormatLocalTime(log.LoggedAt, "MM/dd HH:mm:ss")</span>
                        <span class="log-level">[@log.Level]</span>
                        <span class="log-message">@log.Message</span>
                    </div>
                }
            </div>
        }

        <button class="btn-secondary" @onclick="LoadLogs">🔄 Refresh Logs</button>
    </div>

    <div class="settings-section">
        <h4>Demo Mode</h4>
        <p>Use simulated sensor readings instead of real hardware.</p>

        <button class="btn-secondary" @onclick="ToggleDemoMode">
            @if (IsDemoMode)
            {
                <span>🛑 Disable Demo Mode</span>
            }
            else
            {
                <span>▶️ Enable Demo Mode</span>
            }
        </button>

        @if (IsDemoMode)
        {
            <div class="success-message mt-2">🎭 Demo mode is currently <strong>enabled</strong>.</div>
        }
    </div>

    <div class="settings-section">
        <h4>System Information</h4>
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Total Zones:</span>
                <span class="info-value">@TotalZones</span>
            </div>
            <div class="info-item">
                <span class="info-label">Database:</span>
                <span class="info-value">PostgreSQL</span>
            </div>
            <div class="info-item">
                <span class="info-label">MQTT Broker:</span>
                <span class="info-value">Mosquitto</span>
            </div>
            <div class="info-item">
                <span class="info-label">Auto-refresh:</span>
                <span class="info-value">5 seconds</span>
            </div>
        </div>
    </div>
</div>

@code {
    private SystemSettings? SystemConfig;
    private AiIrrigationOptions? AiConfig;
    private WeatherIntegrationSettings? WeatherConfig;
    private AiIrrigationDecisionLog? LatestAiDecision;
    private AiApiCheckResult? LatestAiApiCheck;
    private IrrigationDecisionResult? AiSituationResult;
    private List<SystemLog> SystemLogs = new();
    private List<Zone> Zones = new();
    
    private bool IsLoadingLogs = true;
    private bool IsRunning = false;
    private bool AnalysisComplete = false;
    private bool IsCleaning = false;
    private bool CleanupComplete = false;
    private bool IsSavingAiSettings = false;
    private bool IsTestingAiApi = false;
    private bool IsTestingAiSituation = false;
    private bool IsResettingAiCooldowns = false;
    private bool AiSettingsSaved = false;
    private bool AiCooldownsReset = false;
    private string? AiSettingsError;
    private string? AiSituationError;
    private bool IsSavingWeatherSettings = false;
    private bool WeatherSettingsSaved = false;
    private string? WeatherSettingsError;
    private WeatherWateringAdvice? LatestWeatherAdvice;

    private bool IsDemoMode = false;
    private int TotalZones = 0;

    private int CleanupRetentionSeconds = 30 * 24 * 60 * 60;
    private int DeletedRecords = 0;
    private int AiTestZoneId = 1;
    private float AiTestMoisture = 20;
    private float AiTestTemperature = 24;
    private float AiTestHumidity = 60;
    private float? AiTestPressure = 1013.25f;
    
    private System.Threading.Timer? SaveTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
        await LoadAiSettings();
        await LoadWeatherSettings();
        await LoadZones();
        await LoadLogs();

        IsDemoMode = DemoService.IsDemoMode;
    }

    public void Dispose()
    {
        SaveTimer?.Dispose();
    }

    private async Task LoadSettings()
    {
        SystemConfig = await DataService.GetSystemSettingsAsync();
        if (SystemConfig == null)
        {
            SystemConfig = new SystemSettings();
        }
    }

    private async Task LoadZones()
    {
        Zones = await DataService.GetZonesAsync();
        TotalZones = Zones.Count;

        if (Zones.Count > 0 && !Zones.Any(zone => zone.Id == AiTestZoneId))
        {
            AiTestZoneId = Zones[0].Id;
        }
    }

    private async Task LoadAiSettings()
    {
        AiConfig = await DataService.GetAiIrrigationOptionsAsync(AiDefaults.Value);
        LatestAiDecision = await DataService.GetLatestAiDecisionAsync();
        LatestAiApiCheck = AiApiHealth.GetLastResult();
    }

    private async Task LoadWeatherSettings()
    {
        WeatherConfig = await DataService.GetWeatherSettingsAsync();
        LatestWeatherAdvice = await Weather.GetAdviceAsync();
    }

    private bool IsAiApiKeyMissing =>
        AiConfig != null &&
        AiConfig.RequiresApiKey &&
        !ApiKeyProvider.GetApiKey(AiConfig.ApiKeyEnvironmentVariable).IsConfigured;

    private string GetAiProviderAccessStatus()
    {
        if (AiConfig == null)
        {
            return "Unknown";
        }

        if (AiConfig.UsesOllama)
        {
            return AiConfig.OllamaBaseUrl;
        }

        var lookup = ApiKeyProvider.GetApiKey(AiConfig.ApiKeyEnvironmentVariable);
        return lookup.IsConfigured ? $"Configured ({lookup.Source})" : "Missing";
    }

    private string GetAiApiKeySource()
    {
        if (AiConfig == null)
        {
            return "OpenAI API key";
        }

        return ApiKeyProvider.GetApiKey(AiConfig.ApiKeyEnvironmentVariable).Source;
    }

    private string GetLatestAiDecisionSummary()
    {
        if (LatestAiDecision == null)
        {
            return "No decisions";
        }

        var mode = LatestAiDecision.AiWasAttempted ? "AI" : "Fallback";
        return $"{mode} {FormatLocalTime(LatestAiDecision.Timestamp, "MM/dd HH:mm")}";
    }

    private static string FormatLocalTime(DateTime utcTime, string format)
    {
        return DateTime.SpecifyKind(utcTime, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString(format);
    }

    private async Task SaveAiSettings()
    {
        if (AiConfig == null)
        {
            return;
        }

        IsSavingAiSettings = true;
        AiSettingsSaved = false;
        AiSettingsError = null;

        if (AiConfig.RequiresApiKey && LooksLikeSecretApiKey(AiConfig.ApiKeyEnvironmentVariable))
        {
            AiConfig.ApiKeyEnvironmentVariable = "OPENAI_API_KEY";
            AiSettingsError = "That field is only for the environment variable name. Put the actual secret key in PowerShell as OPENAI_API_KEY, then restart the web app.";
            IsSavingAiSettings = false;
            return;
        }

        if (AiConfig.RequiresApiKey && (AiConfig.ApiKeyEnvironmentVariable?.Length ?? 0) > 100)
        {
            AiSettingsError = "Environment variable names must be short. Use OPENAI_API_KEY here and put the long secret key in PowerShell.";
            IsSavingAiSettings = false;
            return;
        }

        if (AiConfig.UsesOllama && (AiConfig.OllamaBaseUrl?.Length ?? 0) > 200)
        {
            AiSettingsError = "Ollama base URLs must be 200 characters or fewer.";
            IsSavingAiSettings = false;
            return;
        }

        try
        {
            if (await DataService.UpdateAiIrrigationOptionsAsync(AiConfig))
            {
                await LoadAiSettings();
                await LoadLogs();
                AiSettingsSaved = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(2500);
                AiSettingsSaved = false;
            }
        }
        finally
        {
            IsSavingAiSettings = false;
        }
    }

    private async Task SaveWeatherSettings()
    {
        if (WeatherConfig == null) return;

        IsSavingWeatherSettings = true;
        WeatherSettingsSaved = false;
        WeatherSettingsError = null;

        try 
        {
            NormalizeWeatherSettings(WeatherConfig);
            if (await DataService.UpdateWeatherSettingsAsync(WeatherConfig))
            {
                Weather.ClearCache();
                LatestWeatherAdvice = await Weather.GetAdviceAsync(forceRefresh: true);
                await LoadLogs();
                WeatherSettingsSaved = true;
            }
            else
            {
                WeatherSettingsError = "Weather settings could not be saved. Check the system logs for details.";
            }

            await Task.Delay(2500);
            WeatherSettingsSaved = false;
        } 
        finally 
        {
            IsSavingWeatherSettings = false;
        }
    }

    private async Task TestWeatherApi()
    {
        Weather.ClearCache();
        var advice = await Weather.GetAdviceAsync(forceRefresh: true);
        LatestWeatherAdvice = advice;
        await DataService.LogSystemMessageAsync("INFO", $"Weather API Test: {advice.AdviceText}");
        await LoadLogs();
    }

    private static void NormalizeWeatherSettings(WeatherIntegrationSettings settings)
    {
        settings.Latitude = double.IsFinite(settings.Latitude) && settings.Latitude >= -90 && settings.Latitude <= 90
            ? settings.Latitude
            : 42.5048;
        settings.Longitude = double.IsFinite(settings.Longitude) && settings.Longitude >= -180 && settings.Longitude <= 180
            ? settings.Longitude
            : 27.4626;
        settings.RainProbabilityThresholdPercent = Math.Clamp(settings.RainProbabilityThresholdPercent, 0, 100);
        settings.RainLookaheadHours = Math.Clamp(settings.RainLookaheadHours, 1, 48);
        settings.ExpectedRainMmThreshold = Math.Clamp(settings.ExpectedRainMmThreshold, 0, 100);
        settings.ConfirmedWeatherPauseHours = Math.Clamp(settings.ConfirmedWeatherPauseHours, 1, 72);
    }

    private static string FormatTemperature(float? temperature)
    {
        return temperature.HasValue
            ? $"{temperature.Value.ToString("F1", CultureInfo.InvariantCulture)} C"
            : "Unavailable";
    }

    private static string FormatTemperatureRange(float? minTemperature, float? maxTemperature)
    {
        return minTemperature.HasValue && maxTemperature.HasValue
            ? $"{FormatTemperature(minTemperature)} to {FormatTemperature(maxTemperature)}"
            : "Unavailable";
    }

