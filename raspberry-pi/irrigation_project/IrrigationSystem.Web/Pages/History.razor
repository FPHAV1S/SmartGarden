@page "/history"
@layout MainLayout
@inject SensorDataService DataService

<PageTitle>History - Irrigation System</PageTitle>

<div class="history-page">
    <h3>Sensor History</h3>

    <div class="filters">
        <label>
            Zone:
            <select @bind="SelectedZoneId" @bind:after="LoadHistory" disabled="@(Zones.Count == 0)">
                @if (Zones.Count == 0)
                {
                    <option value="0">No zones configured</option>
                }
                else
                {
                    @foreach (var zone in Zones)
                    {
                        <option value="@zone.Id">@GetZoneOptionLabel(zone)</option>
                    }
                }
            </select>
        </label>

        <label>
            Time Range:
            <select @bind="TimeRangeHours" @bind:after="LoadHistory">
                <option value="6">Last 6 Hours</option>
                <option value="12">Last 12 Hours</option>
                <option value="24">Last 24 Hours</option>
                <option value="72">Last 3 Days</option>
                <option value="168">Last Week</option>
            </select>
        </label>

        <label>
            Chart Average:
            <select @bind="ChartBucketMinutes" @bind:after="ApplyChartAveraging">
                <option value="0">No averaging</option>
                <option value="1">1 minute</option>
                <option value="5">5 minutes</option>
                <option value="10">10 minutes</option>
                <option value="15">15 minutes</option>
                <option value="30">30 minutes</option>
                <option value="60">60 minutes</option>
            </select>
        </label>

        <button class="btn-refresh" @onclick="RefreshHistory">Refresh</button>
    </div>

    @if (IsLoading)
    {
        <p>Loading data...</p>
    }
    else if (Zones.Count == 0)
    {
        <p>No zones configured yet.</p>
    }
    else if (HistoryData.Count == 0)
    {
        <p>No data available for this time range.</p>
    }
    else
    {
        <div class="charts-grid">
            <div class="chart-card metric-card metric-moisture">
                <div class="chart-card-header">
                    <div>
                        <h4>Moisture</h4>
                        <span>Soil water level</span>
                    </div>
                    <div class="metric-pill"><span></span>%</div>
                </div>
                @if (MoistureChartData.Count > 0)
                {
                    <RadzenChart class="history-chart" Style="height: 300px;">
                        <RadzenLegend Visible="false" />
                        <RadzenLineSeries Data="@MoistureChartData"
                                          CategoryProperty="RecordedAt"
                                          ValueProperty="Value"
                                          Title="Moisture"
                                          Stroke="#FF6B35"
                                          StrokeWidth="2">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Fill="#FF6B35" Size="4" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis FormatString="{0:HH:mm}" />
                        <RadzenValueAxis Min="0" Max="100">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                }
                else
                {
                    <p class="no-data">No moisture data available.</p>
                }
            </div>

            <div class="chart-card metric-card metric-temperature">
                <div class="chart-card-header">
                    <div>
                        <h4>Temperature</h4>
                        <span>Ambient sensor reading</span>
                    </div>
                    <div class="metric-pill"><span></span>°C</div>
                </div>
                @if (TemperatureChartData.Count > 0)
                {
                    <RadzenChart class="history-chart" Style="height: 300px;">
                        <RadzenLegend Visible="false" />
                        <RadzenLineSeries Data="@TemperatureChartData"
                                          CategoryProperty="RecordedAt"
                                          ValueProperty="Value"
                                          Title="Temperature"
                                          Stroke="#DC143C"
                                          StrokeWidth="2">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Fill="#DC143C" Size="4" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis FormatString="{0:HH:mm}" />
                        <RadzenValueAxis Min="0" Max="40">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                }
                else
                {
                    <p class="no-data">No temperature data available.</p>
                }
            </div>

            <div class="chart-card metric-card metric-humidity">
                <div class="chart-card-header">
                    <div>
                        <h4>Humidity</h4>
                        <span>Air moisture level</span>
                    </div>
                    <div class="metric-pill"><span></span>%</div>
                </div>
                @if (HumidityChartData.Count > 0)
                {
                    <RadzenChart class="history-chart" Style="height: 300px;">
                        <RadzenLegend Visible="false" />
                        <RadzenLineSeries Data="@HumidityChartData"
                                          CategoryProperty="RecordedAt"
                                          ValueProperty="Value"
                                          Title="Humidity"
                                          Stroke="#4169E1"
                                          StrokeWidth="2">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Fill="#4169E1" Size="4" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis FormatString="{0:HH:mm}" />
                        <RadzenValueAxis Min="0" Max="100">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                }
                else
                {
                    <p class="no-data">No humidity data available.</p>
                }
            </div>

            <div class="chart-card metric-card metric-pressure">
                <div class="chart-card-header">
                    <div>
                        <h4>Pressure</h4>
                        <span>Barometric sensor reading</span>
                    </div>
                    <div class="metric-pill"><span></span>hPa</div>
                </div>
                @if (PressureChartData.Count > 0)
                {
                    <RadzenChart class="history-chart" Style="height: 300px;">
                        <RadzenLegend Visible="false" />
                        <RadzenLineSeries Data="@PressureChartData"
                                          CategoryProperty="RecordedAt"
                                          ValueProperty="Value"
                                          Title="Pressure"
                                          Stroke="#2E8B57"
                                          StrokeWidth="2">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Fill="#2E8B57" Size="4" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis FormatString="{0:HH:mm}" />
                        <RadzenValueAxis>
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                }
                else
                {
                    <p class="no-data">No pressure data available.</p>
                }
            </div>
        </div>

        <div class="stats-summary">
            <h4>Summary Statistics</h4>
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <td><strong>Avg Moisture:</strong></td>
                        <td>@HistoryData.Average(d => d.Moisture ?? 0).ToString("F1")%</td>
                    </tr>
                    <tr>
                        <td><strong>Min Moisture:</strong></td>
                        <td>@HistoryData.Min(d => d.Moisture ?? 0).ToString("F1")%</td>
                    </tr>
                    <tr>
                        <td><strong>Max Moisture:</strong></td>
                        <td>@HistoryData.Max(d => d.Moisture ?? 0).ToString("F1")%</td>
                    </tr>
                    <tr>
                        <td><strong>Raw Data Points:</strong></td>
                        <td>@HistoryData.Count</td>
                    </tr>
                    <tr>
                        <td><strong>Avg Pressure:</strong></td>
                        <td>@FormatAverage(HistoryData.Select(d => d.Pressure), "hPa")</td>
                    </tr>
                    <tr>
                        <td><strong>Chart Points:</strong></td>
                        <td>@ChartData.Count</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="data-table">
            <h4>Raw Data</h4>
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Moisture (%)</th>
                        <th>Temperature (°C)</th>
                        <th>Humidity (%)</th>
                        <th>Pressure (hPa)</th>
                        <th>ESP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var data in HistoryData.OrderByDescending(d => d.RecordedAt))
                    {
                        <tr>
                            <td>@FormatLocalTime(data.RecordedAt, "yyyy-MM-dd HH:mm")</td>
                            <td>@(data.Moisture?.ToString("F1") ?? "N/A")</td>
                            <td>@(data.Temperature?.ToString("F1") ?? "N/A")</td>
                            <td>@(data.Humidity?.ToString("F1") ?? "N/A")</td>
                            <td>@(data.Pressure?.ToString("F1") ?? "N/A")</td>
                            <td>@(string.IsNullOrWhiteSpace(data.Device) ? "Unknown" : data.Device)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<SensorReading> HistoryData = new();
    private List<SensorReading> ChartData = new();
    private List<MetricChartPoint> MoistureChartData = new();
    private List<MetricChartPoint> TemperatureChartData = new();
    private List<MetricChartPoint> HumidityChartData = new();
    private List<MetricChartPoint> PressureChartData = new();
    private List<Zone> Zones = new();
    private int SelectedZoneId = 0;
    private int TimeRangeHours = 24;
    private int ChartBucketMinutes = 10;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadZones();
        await LoadHistory();
    }

    private async Task LoadZones()
    {
        Zones = await DataService.GetZonesAsync();

        if (Zones.Count > 0 && !Zones.Any(zone => zone.Id == SelectedZoneId))
        {
            SelectedZoneId = Zones[0].Id;
        }
        else if (Zones.Count == 0)
        {
            SelectedZoneId = 0;
        }
    }

    private async Task LoadHistory()
    {
        IsLoading = true;

        if (SelectedZoneId <= 0)
        {
            HistoryData = new List<SensorReading>();
        }
        else
        {
            HistoryData = await DataService.GetZoneHistoryAsync(SelectedZoneId, TimeRangeHours);
        }

        ApplyChartAveraging();

        IsLoading = false;
    }

    private async Task RefreshHistory()
    {
        await LoadZones();
        await LoadHistory();
    }

    private void ApplyChartAveraging()
    {
        ChartData = BuildAveragedChartData(HistoryData, ChartBucketMinutes);
        MoistureChartData = BuildMetricChartData(ChartData, reading => reading.Moisture);
        TemperatureChartData = BuildMetricChartData(ChartData, reading => reading.Temperature);
        HumidityChartData = BuildMetricChartData(ChartData, reading => reading.Humidity);
        PressureChartData = BuildMetricChartData(ChartData, reading => reading.Pressure);
    }

    private static List<SensorReading> BuildAveragedChartData(IEnumerable<SensorReading> readings, int bucketMinutes)
    {
        var orderedReadings = readings.OrderBy(reading => reading.RecordedAt).ToList();
        if (bucketMinutes <= 0)
        {
            return orderedReadings;
        }

        var bucketTicks = TimeSpan.FromMinutes(bucketMinutes).Ticks;

        return orderedReadings
            .GroupBy(reading => reading.RecordedAt.Ticks / bucketTicks)
            .Select(group =>
            {
                var bucket = group.ToList();
                var first = bucket.First();

                return new SensorReading
                {
                    ZoneId = first.ZoneId,
                    RecordedAt = new DateTime(group.Key * bucketTicks, first.RecordedAt.Kind),
                    Moisture = AverageNullable(bucket.Select(reading => reading.Moisture)),
                    Temperature = AverageNullable(bucket.Select(reading => reading.Temperature)),
                    Humidity = AverageNullable(bucket.Select(reading => reading.Humidity)),
                    Pressure = AverageNullable(bucket.Select(reading => reading.Pressure))
                };
            })
            .OrderBy(reading => reading.RecordedAt)
            .ToList();
    }

    private static List<MetricChartPoint> BuildMetricChartData(
        IEnumerable<SensorReading> readings,
        Func<SensorReading, float?> valueSelector)
    {
        return readings
            .Select(reading => new
            {
                RecordedAt = ToLocalTime(reading.RecordedAt),
                Value = valueSelector(reading)
            })
            .Where(point => point.Value.HasValue)
            .Select(point => new MetricChartPoint(point.RecordedAt, point.Value!.Value))
            .ToList();
    }

    private static float? AverageNullable(IEnumerable<float?> values)
    {
        var total = 0f;
        var count = 0;

        foreach (var value in values)
        {
            if (!value.HasValue)
            {
                continue;
            }

            total += value.Value;
            count++;
        }

        return count == 0 ? null : total / count;
    }

    private static string FormatAverage(IEnumerable<float?> values, string unit)
    {
        var average = AverageNullable(values);
        return average.HasValue ? $"{average.Value:F1} {unit}" : "N/A";
    }

    private static DateTime ToLocalTime(DateTime utcTime)
    {
        return DateTime.SpecifyKind(utcTime, DateTimeKind.Utc).ToLocalTime();
    }

    private static string FormatLocalTime(DateTime utcTime, string format)
    {
        return ToLocalTime(utcTime).ToString(format);
    }

    private static string GetZoneOptionLabel(Zone zone)
    {
        return string.IsNullOrWhiteSpace(zone.Name)
            ? $"Zone {zone.Id}"
            : $"{zone.Name} (Zone {zone.Id})";
    }

    private sealed record MetricChartPoint(DateTime RecordedAt, float Value);
}
