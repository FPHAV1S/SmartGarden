@page "/"
@layout MainLayout
@using System.Globalization
@inject SensorDataService DataService
@inject IValveCommandService ValveCommands
@inject WeatherForecastService Weather
@implements IDisposable

<PageTitle>Dashboard - Irrigation System</PageTitle>

<style>
    .weather-card {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        border-left: 4px solid #007bff;
    }
    .weather-warning {
        background: #fff3cd;
        border-left-color: #ffc107;
    }
    .weather-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .weather-header h4 {
        margin: 0;
    }
    .info-row {
        display: flex;
        justify-content: space-between;
        max-width: 250px;
        margin-bottom: 5px;
    }
    .warning-text {
        color: #856404;
        font-weight: bold;
        margin-top: 10px;
    }
    .notice-box {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 20px;
    }
    .weather-actions {
        margin-top: 10px;
    }
    .pause-active {
        color: #d39e00;
        font-weight: bold;
    }
</style>

<div class="dashboard">
    <h3>Live Sensor Data</h3>

    @if (IsLoading)
    {
        <p>Loading sensor data...</p>
    }
    else if (Zones.Count == 0)
    {
        <p>No zones configured yet.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(DashboardNotice))
        {
            <div class="notice-box">
                @DashboardNotice
            </div>
        }

        @if (WeatherAdvice != null)
        {
            <div class="weather-card @(WeatherAdvice.RainLikelySoon ? "weather-warning" : "weather-ok")">
                <div class="weather-header">
                    <h4>Weather Forecast (Next @WeatherAdvice.LookaheadHours hrs)</h4>
                    <span>@FormatLocalTime(WeatherAdvice.LastUpdated, "HH:mm")</span>
                </div>
                <div class="weather-info">
                    <div class="info-row">
                        <span>Rain Probability:</span>
                        <span>@(WeatherAdvice.IsWeatherDataAvailable ? $"{WeatherAdvice.MaxRainProbabilityPercent}%" : "Unavailable")</span>
                    </div>
                    <div class="info-row">
                        <span>Expected Rain:</span>
                        <span>@(WeatherAdvice.IsWeatherDataAvailable ? $"{WeatherAdvice.ExpectedRainMm.ToString("F1", CultureInfo.InvariantCulture)} mm" : "Unavailable")</span>
                    </div>
                    <div class="info-row">
                        <span>Forecast Temp:</span>
                        <span>@(WeatherAdvice.IsWeatherDataAvailable ? FormatTemperature(WeatherAdvice.CurrentTemperatureC) : "Unavailable")</span>
                    </div>
                    <p class="weather-advice">@WeatherAdvice.AdviceText</p>
                </div>
                
                @if (WeatherAdvice.RainLikelySoon)
                {
                    <p class="warning-text">Rain is expected soon. Recommended: do not water.</p>
                }

                <div class="weather-actions">
                    @if (ActiveBlock != null)
                    {
                        <span class="pause-active">Watering paused until @FormatLocalTime(ActiveBlock.ActiveUntil, "HH:mm")</span>
                    }
                    else
                    {
                        <button class="btn-warning" @onclick="ConfirmPause">Confirm pause watering</button>
                    }
                </div>
            </div>
        }

        <div class="zone-grid">
            @foreach (var zone in Zones)
            {
                var reading = GetLatestReading(zone.Id);
                <div class="zone-card">
                    <div class="zone-header">
                        <h4>@zone.Name</h4>
                        <span class="status-indicator @(zone.IsActive ? "active" : "inactive")"></span>
                    </div>

                    @if (reading != null)
                    {
                        <div class="sensor-data">
                            <div class="sensor-item">
                                <span class="label">Moisture:</span>
                                <span class="value">@reading.Moisture?.ToString("F1")%</span>
                            </div>
                            <div class="sensor-item">
                                <span class="label">Temperature:</span>
                                <span class="value">@reading.Temperature?.ToString("F1")°C</span>
                            </div>
                            <div class="sensor-item">
                                <span class="label">Humidity:</span>
                                <span class="value">@reading.Humidity?.ToString("F1")%</span>
                            </div>
                            <div class="sensor-item">
                                <span class="label">Pressure:</span>
                                <span class="value">@(reading.Pressure?.ToString("F1") ?? "N/A") hPa</span>
                            </div>
                            <div class="sensor-item">
                                <span class="label">ESP:</span>
                                <span class="value">@(string.IsNullOrWhiteSpace(reading.Device) ? "Unknown" : reading.Device)</span>
                            </div>
                            <div class="last-update">
                                Updated: @FormatLocalTime(reading.RecordedAt, "HH:mm:ss")
                            </div>
                        </div>

                        <div class="moisture-bar">
                            <div class="moisture-fill" style="@GetMoistureWidthStyle(reading.Moisture)"></div>
                        </div>

                        @if (WeatherAdvice?.RainLikelySoon == true)
                        {
                            <div class="warning-text">Rain is likely soon. Manual watering is still available, but use caution.</div>
                        }
                        <button class="btn-water" @onclick="() => WaterZone(zone.Id)">
                            💧 Water Now
                        </button>
                    }
                    else
                    {
                        <p class="no-data">No sensor data available</p>
                    }
                </div>
            }
        </div>
    }

    <button class="btn-refresh" @onclick="RefreshData">🔄 Refresh</button>
</div>

@code {
    private List<Zone> Zones = new();
    private List<SensorReading> LatestReadings = new();
    private WeatherWateringAdvice? WeatherAdvice;
    private ActiveWateringBlock? ActiveBlock;
    private AiIrrigationOptions AiConfig = new();
    private List<IrrigationEvent> RecentWateringEvents = new();
    private string? DashboardNotice;
    private bool IsLoading = true;
    private System.Threading.Timer? RefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        
        RefreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        IsLoading = true;
        Zones = await DataService.GetZonesAsync();
        LatestReadings = await DataService.GetLatestReadingsAsync();
        AiConfig = await DataService.GetAiIrrigationOptionsAsync(new AiIrrigationOptions());
        RecentWateringEvents = await DataService.GetRecentIrrigationEventsAsync(10);
        WeatherAdvice = await Weather.GetAdviceAsync();
        ActiveBlock = await DataService.GetActiveWateringBlockAsync();
        DashboardNotice = BuildDashboardNotice();
        IsLoading = false;
    }

    private SensorReading? GetLatestReading(int zoneId)
    {
        return LatestReadings.FirstOrDefault(r => r.ZoneId == zoneId);
    }

    private static string GetMoistureWidthStyle(float? moisture)
    {
        var value = Math.Clamp(moisture ?? 0, 0, 100);
        return $"width: {value.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private static string FormatTemperature(float? temperature)
    {
        return temperature.HasValue
            ? $"{temperature.Value.ToString("F1", CultureInfo.InvariantCulture)} C"
            : "Unavailable";
    }

    private static string FormatLocalTime(DateTime utcTime, string format)
    {
        return DateTime.SpecifyKind(utcTime, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString(format);
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task ConfirmPause()
    {
        var settings = await DataService.GetWeatherSettingsAsync();
        var until = DateTime.UtcNow.AddHours(settings.ConfirmedWeatherPauseHours);
        await DataService.CreateWateringBlockAsync("Confirmed weather pause", "Dashboard", until);
        ActiveBlock = await DataService.GetActiveWateringBlockAsync();
        DashboardNotice = $"Confirmed weather pause is active until {FormatLocalTime(until, "HH:mm")}.";
    }

    private string? BuildDashboardNotice()
    {
        if (ActiveBlock != null)
        {
            return $"Active weather pause is blocking automatic watering until {FormatLocalTime(ActiveBlock.ActiveUntil, "HH:mm")}. Reason: {ActiveBlock.Reason}.";
        }

        if (AiConfig?.EnableWateringCooldown != true || AiConfig.MinimumMinutesBetweenWaterings <= 0)
        {
            return null;
        }

        var cooldownMinutes = AiConfig.MinimumMinutesBetweenWaterings;
        var zonesInCooldown = new List<string>();

        foreach (var zone in Zones.Where(z => z.IsActive))
        {
            var recentEvent = RecentWateringEvents
                .Where(e => e.ZoneId == zone.Id)
                .Select(e => new { Event = e, Timestamp = e.EndedAt ?? e.StartedAt })
                .Where(x => x.Timestamp != default)
                .OrderByDescending(x => x.Timestamp)
                .FirstOrDefault();

            if (recentEvent != null)
            {
                var minutesSince = (DateTime.UtcNow - recentEvent.Timestamp).TotalMinutes;
                if (minutesSince >= 0 && minutesSince < cooldownMinutes)
                {
                    var remaining = Math.Max(0, cooldownMinutes - minutesSince);
                    zonesInCooldown.Add($"{zone.Name} (~{remaining:F0}m)");
                }
            }
        }

        if (zonesInCooldown.Count > 0)
        {
            return $"Auto-watering cooldown active for: {string.Join(", ", zonesInCooldown)}.";
        }

        return null;
    }

    private async Task WaterZone(int zoneId)
    {
        var reading = GetLatestReading(zoneId);
        var moistureBefore = reading?.Moisture;

        var success = await ValveCommands.OpenValveAsync(zoneId, 10);
        
        if (success)
        {
            var eventId = await DataService.StartIrrigationEventAsync(zoneId, "Manual", moistureBefore);

            await Task.Delay(10000);
            await ValveCommands.CloseValveAsync(zoneId);
            if (eventId > 0)
            {
                await DataService.EndIrrigationEventAsync(eventId, 10, null);
            }
        }
    }

    public void Dispose()
    {
        RefreshTimer?.Dispose();
    }
}
